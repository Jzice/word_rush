    "smoke": "vite build && node e2e/smoke.mjs",
    "bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "^1.64.1",
    "terser": "^5.51.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
