{
  "name": "word-rush",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "WORD RUSH 单词快打 · 多教材多词库词汇特训（单文件发布）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development --minify false",
    "typecheck": "tsc --noEmit",
